# Database Credentials
DB_HOST=YOUR_LOCALHOST
DB_PORT=5432
DB_NAME=YOUR_DATABASE_NAME
DB_USERNAME=YOUR_USER
DB_PASSWORD=YOUR_PASSWORD

# JWT Configuration (Secret key min 256 bits = 32 bytes hex/base64, Expiration in ms: 86400000 = 24h)
JWT_SECRET_KEY=your_secret_key
JWT_EXPIRATION_MS=86400000 #default 24h for dev