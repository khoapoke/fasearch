{
  "openapi": "3.1.0",
  "info": {
    "title": "FaSearch Public API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "getCsrfToken",
        "summary": "Create or read the current session CSRF token",
        "responses": {
          "200": {
            "description": "CSRF header name and token",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CsrfResponse" } } }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "parameters": [
          { "name": "X-CSRF-TOKEN", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string", "format": "password" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Session authenticated; Set-Cookie rotates the opaque session ID" },
          "401": { "$ref": "#/components/responses/AuthError" },
          "403": { "$ref": "#/components/responses/AuthError" }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [
          { "name": "X-CSRF-TOKEN", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Current session invalidated" },
          "401": { "$ref": "#/components/responses/AuthError" },
          "403": { "$ref": "#/components/responses/AuthError" }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "Current account and effective authorities",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CurrentUser" } } }
          },
          "401": { "$ref": "#/components/responses/AuthError" }
        }
      }
    },
    "/api/v1/catalog/admin/drafts": {
      "post": {
        "operationId": "createCatalogDraft",
        "parameters": [
          { "name": "X-CSRF-TOKEN", "in": "header", "required": true, "schema": { "type": "string" } },
          { "name": "X-Trace-Id", "in": "header", "required": false, "schema": { "type": "string", "maxLength": 128 } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DraftInput" } } }
        },
        "responses": {
          "201": {
            "description": "Draft Product Version 1 created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogDraft" } } }
          },
          "400": { "$ref": "#/components/responses/AuthError" },
          "401": { "$ref": "#/components/responses/AuthError" },
          "403": { "$ref": "#/components/responses/AuthError" }
        }
      }
    },
    "/api/v1/catalog/admin/drafts/{productId}": {
      "parameters": [
        { "name": "productId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "get": {
        "operationId": "getCatalogDraft",
        "responses": {
          "200": {
            "description": "Latest Product Version",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogDraft" } } }
          },
          "403": { "$ref": "#/components/responses/AuthError" },
          "404": { "$ref": "#/components/responses/AuthError" }
        }
      },
      "patch": {
        "operationId": "reviseCatalogDraft",
        "parameters": [
          { "name": "X-CSRF-TOKEN", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DraftRevision" } } }
        },
        "responses": {
          "200": {
            "description": "A new immutable Draft Product Version",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CatalogDraft" } } }
          },
          "400": { "$ref": "#/components/responses/AuthError" },
          "403": { "$ref": "#/components/responses/AuthError" },
          "409": { "$ref": "#/components/responses/AuthError" }
        }
      }
    },
    "/api/v1/catalog/images/{productId}/{productVersionId}": {
      "get": {
        "operationId": "getActiveProductImage",
        "summary": "Read the image of an active catalog product version",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "productVersionId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Image bytes for the active product version",
            "content": {
              "image/jpeg": { "schema": { "type": "string", "format": "binary" } },
              "image/png": { "schema": { "type": "string", "format": "binary" } },
              "image/webp": { "schema": { "type": "string", "format": "binary" } }
            }
          },
          "404": { "description": "Product version is not active or has no readable image" }
        }
      }
    },
    "/api/v1/search/image": {
      "post": {
        "operationId": "searchByImage",
        "summary": "Search the active fashion catalog by image",
        "parameters": [
          {
            "name": "X-Trace-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["image"],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "k": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 10
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked products from one consistent publication",
            "headers": {
              "X-Trace-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageSearchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/SearchError"
          },
          "413": {
            "$ref": "#/components/responses/SearchError"
          },
          "415": {
            "$ref": "#/components/responses/SearchError"
          },
          "503": {
            "$ref": "#/components/responses/SearchError"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "AuthError": {
        "description": "Authentication, authorization or catalog validation error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/AuthError" }
          }
        }
      },
      "SearchError": {
        "description": "Stable public search error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "AuthError": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "CsrfResponse": {
        "type": "object",
        "required": ["header_name", "token"],
        "properties": {
          "header_name": { "type": "string" },
          "token": { "type": "string" }
        }
      },
      "CurrentUser": {
        "type": "object",
        "required": ["username", "authorities"],
        "properties": {
          "username": { "type": "string" },
          "authorities": { "type": "array", "items": { "type": "string" } }
        }
      },
      "DraftInput": {
        "type": "object",
        "required": ["title", "category"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 250 },
          "description": { "type": ["string", "null"], "maxLength": 4000 },
          "category": { "type": "string", "enum": ["TOP", "BOTTOM", "ONE_PIECE"] }
        }
      },
      "DraftRevision": {
        "allOf": [
          { "$ref": "#/components/schemas/DraftInput" },
          {
            "type": "object",
            "required": ["expected_version_no"],
            "properties": { "expected_version_no": { "type": "integer", "minimum": 1 } }
          }
        ]
      },
      "CatalogDraft": {
        "type": "object",
        "required": ["product_id", "product_version_id", "version_no", "status", "title", "category", "created_by", "created_at"],
        "properties": {
          "product_id": { "type": "string", "format": "uuid" },
          "product_version_id": { "type": "string", "format": "uuid" },
          "version_no": { "type": "integer", "minimum": 1 },
          "status": { "type": "string", "enum": ["DRAFT", "PROCESSING", "NEEDS_REVIEW", "INDEXED", "ACTIVE", "FAILED", "ARCHIVED"] },
          "title": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "category": { "type": "string", "enum": ["TOP", "BOTTOM", "ONE_PIECE"] },
          "created_by": { "type": "string", "format": "uuid" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Publication": {
        "type": "object",
        "additionalProperties": false,
        "required": ["catalog_snapshot_id", "model_version", "index_version"],
        "properties": {
          "catalog_snapshot_id": {
            "type": "string"
          },
          "model_version": {
            "type": "string"
          },
          "index_version": {
            "type": "string"
          }
        }
      },
      "SearchProduct": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "product_version_id",
          "rank",
          "similarity_score",
          "title",
          "category",
          "image_url"
        ],
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_version_id": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "similarity_score": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": ["TOP", "BOTTOM", "ONE_PIECE"]
          },
          "image_url": {
            "type": "string"
          }
        }
      },
      "Latency": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ai_latency_ms", "total_latency_ms"],
        "properties": {
          "ai_latency_ms": {
            "type": "number",
            "minimum": 0
          },
          "total_latency_ms": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "ImageSearchResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "trace_id",
          "mode",
          "publication",
          "results",
          "latency"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0.0"
          },
          "trace_id": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "const": "IMAGE"
          },
          "publication": {
            "$ref": "#/components/schemas/Publication"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchProduct"
            }
          },
          "latency": {
            "$ref": "#/components/schemas/Latency"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "code", "message"],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0.0"
          },
          "trace_id": {
            "type": ["string", "null"]
          },
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_IMAGE",
              "IMAGE_TOO_LARGE",
              "AI_UNAVAILABLE",
              "AI_PUBLICATION_MISMATCH",
              "CATALOG_VERSION_MISMATCH"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
