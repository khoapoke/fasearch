{
  "openapi": "3.1.0",
  "info": {
    "title": "FaSearch Public API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/catalog/images/{productId}/{productVersionId}": {
      "get": {
        "operationId": "getActiveProductImage",
        "summary": "Read the image of an active catalog product version",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "productVersionId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Image bytes for the active product version",
            "content": {
              "image/jpeg": { "schema": { "type": "string", "format": "binary" } },
              "image/png": { "schema": { "type": "string", "format": "binary" } },
              "image/webp": { "schema": { "type": "string", "format": "binary" } }
            }
          },
          "404": { "description": "Product version is not active or has no readable image" }
        }
      }
    },
    "/api/v1/search/image": {
      "post": {
        "operationId": "searchByImage",
        "summary": "Search the active fashion catalog by image",
        "parameters": [
          {
            "name": "X-Trace-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["image"],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "k": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 10
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked products from one consistent publication",
            "headers": {
              "X-Trace-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageSearchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/SearchError"
          },
          "413": {
            "$ref": "#/components/responses/SearchError"
          },
          "415": {
            "$ref": "#/components/responses/SearchError"
          },
          "503": {
            "$ref": "#/components/responses/SearchError"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "SearchError": {
        "description": "Stable public search error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "Publication": {
        "type": "object",
        "additionalProperties": false,
        "required": ["catalog_snapshot_id", "model_version", "index_version"],
        "properties": {
          "catalog_snapshot_id": {
            "type": "string"
          },
          "model_version": {
            "type": "string"
          },
          "index_version": {
            "type": "string"
          }
        }
      },
      "SearchProduct": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "product_version_id",
          "rank",
          "similarity_score",
          "title",
          "category",
          "image_url"
        ],
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_version_id": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "similarity_score": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": ["TOP", "BOTTOM", "ONE_PIECE"]
          },
          "image_url": {
            "type": "string"
          }
        }
      },
      "Latency": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ai_latency_ms", "total_latency_ms"],
        "properties": {
          "ai_latency_ms": {
            "type": "number",
            "minimum": 0
          },
          "total_latency_ms": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "ImageSearchResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "trace_id",
          "mode",
          "publication",
          "results",
          "latency"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0.0"
          },
          "trace_id": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "const": "IMAGE"
          },
          "publication": {
            "$ref": "#/components/schemas/Publication"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchProduct"
            }
          },
          "latency": {
            "$ref": "#/components/schemas/Latency"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "code", "message"],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0.0"
          },
          "trace_id": {
            "type": ["string", "null"]
          },
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "INVALID_IMAGE",
              "IMAGE_TOO_LARGE",
              "AI_UNAVAILABLE",
              "AI_PUBLICATION_MISMATCH",
              "CATALOG_VERSION_MISMATCH"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
