          "trace_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Trace Id"
          },
          "catalog_snapshot_id": {
            "type": "string",
            "minLength": 1,
            "title": "Catalog Snapshot Id"
          },
          "model_version": {
            "type": "string",
            "minLength": 1,
            "title": "Model Version"
          },
          "index_version": {
            "type": "string",
            "minLength": 1,
            "title": "Index Version"
          },
          "k": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "K",
            "default": 10
