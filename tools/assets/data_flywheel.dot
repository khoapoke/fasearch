digraph G {
  graph [layout=circo, bgcolor="white", pad=0.3, overlap=false, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#EAF2F8", color="#4F6B81", fontname="Arial", fontsize=11, margin="0.14,0.09"];
  edge [color="#607D8B", penwidth=1.3, arrowsize=0.75];

  label [label="Auto label\nand confidence"];
  gate [label="Threshold gate"];
  review [label="Human review"];
  compare [label="Compare errors\nand slices"];
  active [label="Active review\nsampling"];
  improve [label="Prompt rules\ncalibration fine tune"];

  label -> gate -> review -> compare -> active -> improve -> label;
}
