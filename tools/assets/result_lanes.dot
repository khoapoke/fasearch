digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.45, fontname="Arial"];
  node [shape=box, style="rounded,filled", color="#4F6B81", fontname="Arial", fontsize=10, margin="0.14,0.08"];
  edge [color="#607D8B", penwidth=1.15, arrowsize=0.7];

  candidate [label="Dense top N candidates", fillcolor="#D6EAF8"];
  state [label="Evaluate every hard constraint\nSATISFIED  VIOLATED  UNKNOWN", fillcolor="#EAF2F8"];
  exact [label="Exact verified\nAll hard constraints satisfied", fillcolor="#D5F5E3"];
  sub [label="Near substitute\nTransparent relaxation", fillcolor="#FCF3CF"];
  unknown [label="Unverified\nCritical facet unknown", fillcolor="#FDEDEC"];

  candidate -> state;
  state -> exact [label="all satisfied", fontname="Arial", fontsize=8];
  state -> sub [label="relaxable violation", fontname="Arial", fontsize=8];
  state -> unknown [label="missing or low confidence", fontname="Arial", fontsize=8];
}
